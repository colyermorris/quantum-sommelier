# Quantum Sommelier — runtime environment (example).
# Copy to `.env` and fill in real values.

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

GITHUB_TOKEN=github_pat_...

REDIS_URL=redis://127.0.0.1:6379/0

QS_PER_IP_LIMIT=5
# Global cap across all IPs — hard ceiling on Anthropic spend per hour.
QS_GLOBAL_LIMIT=7
QS_MAX_REPO_BYTES=524288000
QS_SCAN_TIMEOUT_S=120
